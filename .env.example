# Supabase
# API keys overview: https://supabase.com/docs/guides/api/api-keys
# Project URL only, no trailing slash and no /rest/v1 (e.g. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Production: set to your app URL so login/callback redirect to production, not localhost.
# Vercel Production must have NEXT_PUBLIC_SITE_URL=https://we-agree.vercel.app (no trailing slash).
# Also set Supabase Dashboard → Authentication → URL Configuration → Site URL to the same.
# NEXT_PUBLIC_SITE_URL=https://we-agree.vercel.app

# -----------------------------------------------------------------------------
# Passkeys (WebAuthn)
# -----------------------------------------------------------------------------
# Relying Party ID for WebAuthn. If unset, defaults to NEXT_PUBLIC_SITE_URL hostname, else "localhost".
# WEBAUTHN_RP_ID=we-agree.vercel.app
#
# Require passkey confirmation when signing agreements (server-side).
# Set to "false" for local dev to allow KMS-only signing.
# AGREEMENT_PASSKEY_REQUIRED=false
#
# Client-side toggle for passkey UX (must match server-side for consistent behavior).
# NEXT_PUBLIC_AGREEMENT_PASSKEY_REQUIRED=false

# -----------------------------------------------------------------------------
# Blockchain anchoring (final proof hash)
# -----------------------------------------------------------------------------
# Your app calls this endpoint with POST { "hash": "<final_proof_hash>" }.
# If you deploy the built-in Vercel endpoint, set this to your own domain:
# BLOCKCHAIN_RPC_URL=https://we-agree.vercel.app/api/anchor
#
# Optional: protect /api/anchor with a bearer token.
# BLOCKCHAIN_RPC_API_KEY=replace-with-a-strong-random-secret
#
# Display name used by UI (and returned by /api/anchor).
# BLOCKCHAIN_CHAIN_NAME=arbitrum-sepolia

# -----------------------------------------------------------------------------
# Built-in Vercel anchor endpoint (/api/anchor) – EVM settings
# -----------------------------------------------------------------------------
# EVM JSON-RPC URL (e.g. Arbitrum Sepolia RPC endpoint; Google Cloud Blockchain RPC works too).
# BLOCKCHAIN_EVM_RPC_URL=https://your-evm-rpc.example
#
# Private key for the anchoring wallet (use a dedicated wallet with minimal funds/permissions).
# BLOCKCHAIN_EVM_PRIVATE_KEY=0x...
#
# Deployed WeAgreeAnchor contract address on your target chain.
# BLOCKCHAIN_EVM_CONTRACT_ADDRESS=0x...
